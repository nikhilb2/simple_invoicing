# Frontend Environment Variables Template
# Copy this file to .env.development or .env.production and update values

# API Base URL - use /api so the Vite dev-server proxy forwards to the backend
VITE_API_BASE_URL=/api

# Application display name
VITE_APP_NAME=Simple Invoicing

# Logging level (debug, info, warn, error)
VITE_LOG_LEVEL=debug

# PostHog product analytics
# Project token from https://eu.posthog.com/settings/project — safe to expose,
# it is write-only. Leave blank to run the app with analytics disabled — that
# is a supported setup and the app stays quiet about it.
VITE_POSTHOG_PROJECT_TOKEN=
# https://eu.i.posthog.com for EU Cloud, https://us.i.posthog.com for US Cloud
VITE_POSTHOG_HOST=https://eu.i.posthog.com
