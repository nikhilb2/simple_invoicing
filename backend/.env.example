# Backend Environment Variables Template
# Copy this file to .env.development or .env.production and update values

# Database Configuration
# For local development: postgresql://simple_user:simple_password@localhost:5432/simple_invoicing
# For Docker: postgresql://simple_user:simple_password@db:5432/simple_invoicing
DATABASE_URL=postgresql://simple_user:simple_password@localhost:5432/simple_invoicing

# JWT Configuration
# Use a strong, random string for production (minimum 32 characters)
SECRET_KEY=dev-secret-key-change-in-production

# Encryption key for SMTP credentials (required in production, optional otherwise)
# SMTP_ENCRYPTION_KEY=

# JWT Algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Debug mode (true for development, false for production)
DEBUG=true

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://invoicing.nikhilbhatia.com

# --- PostHog product analytics ---
# Product events are captured HERE, on the server; the browser only records
# session replays. Leave the key blank and the app runs with analytics off,
# silently, in every environment -- that is a supported setup.
# Project API key from https://eu.posthog.com/settings/project (the same
# phc_... value the frontend uses; it is write-only, not a secret).
POSTHOG_PROJECT_API_KEY=
# https://eu.i.posthog.com for EU Cloud, https://us.i.posthog.com for US Cloud
POSTHOG_HOST=https://eu.i.posthog.com

# Optional: Static API token for MCP server integration
# When set, Bearer requests with this token bypass JWT auth and act as admin
MCP_API_TOKEN=

# Optional: Application environment
# ENVIRONMENT=development

# --- MCP connector / OAuth authorization server ---
# Public origin of this API. Also the OAuth issuer and the base of the MCP resource
# URI (<base>/mcp). Must match what users type into Claude/ChatGPT exactly.
PUBLIC_API_BASE_URL=http://localhost:8000
# Public origin of the web app (OAuth consent screen, citation deep links).
PUBLIC_APP_BASE_URL=http://localhost:5173
MCP_ENABLED=true
# Kill switch for write tools. Leave false until you have reviewed what they expose.
MCP_WRITE_ENABLED=false
# core = curated tool set, all = every generated tool
MCP_DEFAULT_PROFILE=core
OAUTH_DCR_ENABLED=true
OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# --- Marketplace ---
# Allow http:// (non-HTTPS) marketplace URLs, and how long marketplace fetches may take
MARKETPLACE_ALLOW_INSECURE_URL=false
MARKETPLACE_HTTP_TIMEOUT_SECONDS=15

# --- Public share links ---
# Master switch for public share pages, and the ad panel shown on shared invoices
SHARE_LINKS_ENABLED=true
SHARE_AD_ENABLED=true
SHARE_AD_BRAND_NAME=Simple Invoicings
SHARE_AD_HEADLINE=Invoices this clean, in two minutes.
SHARE_AD_TAGLINE=GST-ready invoicing, inventory and ledgers — built for small businesses and freelancers.
SHARE_AD_WEBSITE=https://simpleinvoicings.com
SHARE_AD_CHIPS=1 month free,No credit card,GST-ready
SHARE_AD_CTA_LABEL=Chat on WhatsApp
SHARE_AD_FOOTNOTE=Try free for 1 month
SHARE_AD_PRICE=Rs. 299
SHARE_AD_PRICE_PERIOD=/month
SHARE_AD_PRICE_PREFIX=only
SHARE_AD_PHONE=+91 98710 52105
SHARE_AD_WHATSAPP=919871052105

# --- Automatic backups ---
# Nightly pg_dump written to BACKUP_DIR by an in-process scheduler (midnight IST by default)
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_TIME=00:00
AUTO_BACKUP_TIMEZONE=Asia/Kolkata
AUTO_BACKUP_KEEP=7
AUTO_BACKUP_EMAIL_ENABLED=true
# Comma-separated override; blank means every admin user
# AUTO_BACKUP_EMAIL_TO=
AUTO_BACKUP_EMAIL_MAX_MB=15

# --- UPI ---
# Kill switch for the pay-by-UPI block on public share pages
UPI_QR_ENABLED=true
